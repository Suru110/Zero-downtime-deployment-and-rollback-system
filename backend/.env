# Copy to .env for local development. Replace every replace-* value.
APP_ENV=development
APP_NAME=ReleasePilot
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Compose database and published ports
POSTGRES_DB=releasepilot
POSTGRES_USER=releasepilot
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

ENABLE_MOCK_ADAPTERS=false
# Use the live Minikube cluster for deployment and endpoint discovery.
KUBERNETES_MODE=real
KUBERNETES_IN_CLUSTER=false
KUBECONFIG_PATH=~/.kube/config
K8S_DEFAULT_NAMESPACE=default
# On Windows with the Docker driver, the minikube VM IP (192.168.49.2) is NOT
# directly reachable from the host. Leave K8S_PUBLIC_BASE_URL unset so the
# adapter uses `minikube service --url` to get the tunnelled 127.0.0.1 URL.
# K8S_PUBLIC_BASE_URL=

ARGO_CD_SERVER=http://localhost:8080
ARGO_CD_AUTH_TOKEN=replace-with-local-argocd-token
ARGO_CD_INSECURE_SKIP_TLS_VERIFY=true
TRIVY_SERVER_URL=http://localhost:4954
TRIVY_SEVERITY_THRESHOLD=CRITICAL
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

DEFAULT_HEALTH_CHECK_INTERVAL_SECONDS=5
DEFAULT_HEALTH_CHECK_MAX_ATTEMPTS=6
DEFAULT_ROLLBACK_ENABLED=true

# Keep relative when using the frontend Nginx API proxy.
VITE_API_URL=/api/v1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@releasepilot.local
ADMIN_INITIAL_PASSWORD=replace-with-a-local-admin-password
DEVELOPER_INITIAL_PASSWORD=replace-with-a-local-developer-password
OPERATOR_INITIAL_PASSWORD=replace-with-a-local-operator-password
